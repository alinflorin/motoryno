<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Export options for the App Store–bound release IPA, built by the CD
  pipeline (.github/workflows/cd.yml) after archiving with the imported
  distribution certificate. Not used by CI or local dev builds — see
  ios-exportOptions.plist for those (development/simulator).

  PROVISIONING_PROFILE_SPECIFIER_PLACEHOLDER is substituted at build time
  with the `IOS_PROVISIONING_PROFILE_SPECIFIER` secret (the profile's name
  or UUID) via sed — plists can't read env vars/secrets directly.
-->
<plist version="1.0">
<dict>
	<key>method</key>
	<string>app-store</string>
	<key>teamID</key>
	<string>696KWJ7J76</string>
	<key>signingStyle</key>
	<string>manual</string>
	<key>signingCertificate</key>
	<string>Apple Distribution</string>
	<key>provisioningProfiles</key>
	<dict>
		<key>com.alinflorinciu.motoryno</key>
		<string>PROVISIONING_PROFILE_SPECIFIER_PLACEHOLDER</string>
	</dict>
	<key>compileBitcode</key>
	<false/>
</dict>
</plist>
