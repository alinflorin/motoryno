{
  "name": "motoryno",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "dependencies": {
    "@expo/vector-icons": "^15.1.1",
    "@hookform/resolvers": "^5.9.1",
    "@react-native-community/datetimepicker": "9.2.1",
    "expo": "~57.0.24",
    "expo-asset": "~57.0.18",
    "expo-background-task": "~57.0.19",
    "expo-constants": "~57.0.19",
    "expo-dev-client": "~57.0.19",
    "expo-document-picker": "~57.0.2",
    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.4",
    "expo-linking": "~57.0.10",
    "expo-localization": "~57.0.2",
    "expo-notifications": "~58.0.1",
    "expo-router": "^57.0.22",
    "expo-sharing": "~57.0.21",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "expo-task-manager": "~57.0.19",
    "i18next": "^26.4.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "^7.88.0",
    "react-i18next": "^17.0.14",
    "react-native": "0.86.3",
    "react-native-ble-plx": "^3.5.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "~4.5.1",
    "react-native-safe-area-context": "~5.10.0",
    "react-native-screens": "~4.28.0",
    "react-native-web": "~0.21.2",
    "universal-vin-decoder": "^1.0.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/react": "~19.3.0",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~57.0.2",
    "eslint-config-prettier": "^10.1.8",
    "jest": "^30.5.1",
    "patch-package": "^8.0.1",
    "prettier": "^3.9.7",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "LANG=en_US.UTF-8 LC_ALL=en_US.UTF-8 expo run:android --device",
    "ios": "LANG=en_US.UTF-8 LC_ALL=en_US.UTF-8 expo run:ios --device",
    "android:standalone": "LANG=en_US.UTF-8 LC_ALL=en_US.UTF-8 expo run:android --device --variant release",
    "ios:standalone": "LANG=en_US.UTF-8 LC_ALL=en_US.UTF-8 expo run:ios --device --configuration Release",
    "build:android": "cd android && LANG=en_US.UTF-8 LC_ALL=en_US.UTF-8 ./gradlew assembleRelease",
    "build:ios": "cd ios && LANG=en_US.UTF-8 LC_ALL=en_US.UTF-8 xcodebuild archive -workspace Motoryno.xcworkspace -scheme Motoryno -configuration Release -archivePath ../build/ios/Motoryno.xcarchive -destination 'generic/platform=iOS' -allowProvisioningUpdates && xcodebuild -exportArchive -archivePath ../build/ios/Motoryno.xcarchive -exportPath ../build/ios -exportOptionsPlist ../ios-exportOptions.plist -allowProvisioningUpdates",
    "web": "LANG=en_US.UTF-8 LC_ALL=en_US.UTF-8 expo start --web",
    "build:web": "expo export --platform web",
    "prebuild": "expo prebuild",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit -p .",
    "test": "jest",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test",
    "postinstall": "patch-package"
  },
  "private": true
}
